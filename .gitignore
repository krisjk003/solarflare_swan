.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Raw and Extracted Datasets & Archives
data/raw/*
!data/raw/.gitkeep
data/*/raw/*
!data/*/raw/.gitkeep
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Generated / Local Dataset Artifacts
data/synthetic/*
!data/synthetic/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pkl
*.parquet
*.feather
*.h5
*.hdf5

# Model Checkpoints & Serialized Weights
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors

# Logs and Temporary files
*.log
*.tmp
*.temp

# Do not ignore .gitkeep files in general
!.gitkeep
